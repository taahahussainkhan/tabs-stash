{
  "manifest_version": 3,
  "name": "Lore - Personal Assistant & Tab Stash",
  "version": "3.1.0",
  "description": "Save tabs instantly, free up memory, build your reading shelf, and sync with your Lore personal assistant.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://pdh9ryeacb.execute-api.ap-south-1.amazonaws.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lore Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lore@extension.stash",
      "strict_min_version": "109.0"
    }
  },
  "commands": {
    "stash_all_tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Stash all tabs in current window"
    },
    "open_dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Open TabVault Dashboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

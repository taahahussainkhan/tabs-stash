{
  "name": "lore",
  "version": "3.0.0",
  "private": true,
  "description": "Lore — Personal Assistant & All-in-One Life, Media, and Knowledge Platform",
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "npm --prefix server run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:server": "npm --prefix server run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:server && npm run build:frontend",
    "package:chrome": "node scripts/package-extensions.js chrome",
    "package:firefox": "node scripts/package-extensions.js firefox",
    "package:all": "node scripts/package-extensions.js all",
    "package:lambda": "node scripts/package-lambda.js",
    "build:all": "npm run build && npm run package:all"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
